# Required: Ethereum mainnet RPC endpoint (it usually embeds your API key).
# Any provider works - swap the line, nothing else changes.
#   wss:// / ws://     push subscriptions, lowest latency (recommended)
#   https:// / http:// polling every ~6s, works where WebSockets are blocked
ETH_RPC_URL=wss://mainnet.infura.io/ws/v3/<your-api-key>
# ETH_RPC_URL=https://mainnet.infura.io/v3/<your-api-key>
# ETH_RPC_URL=wss://eth-mainnet.g.alchemy.com/v2/<your-api-key>
# ETH_RPC_URL=ws://127.0.0.1:8546

# Optional notification sinks (console output is always on)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
